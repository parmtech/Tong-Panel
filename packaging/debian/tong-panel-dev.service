[Unit]
Description=Tong Panel unsigned loopback developer preview
After=network.target
Documentation=https://github.com/parmtech/Tong-Panel

[Service]
Type=simple
DynamicUser=yes
StateDirectory=tong-panel-dev
StateDirectoryMode=0700
WorkingDirectory=/var/lib/tong-panel-dev
Environment=TONG_DATA_DIR=/var/lib/tong-panel-dev
ExecStart=/usr/libexec/tong-panel-dev/tongd
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
